CREATE TABLE Account (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    type TEXT NOT NULL,
    initialBalance INTEGER NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL,
    isArchived INTEGER NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM Account ORDER BY isArchived ASC, createdAt ASC;

selectActive:
SELECT * FROM Account WHERE isArchived = 0 ORDER BY createdAt ASC;

selectById:
SELECT * FROM Account WHERE id = ?;

insert:
INSERT INTO Account(name, type, initialBalance, createdAt, isArchived)
VALUES (?, ?, ?, ?, 0);

update:
UPDATE Account SET name = ?, type = ?, initialBalance = ? WHERE id = ?;

setArchived:
UPDATE Account SET isArchived = ? WHERE id = ?;

deleteById:
DELETE FROM Account WHERE id = ?;

countAll:
SELECT COUNT(*) FROM Account;

lastInsertRowId:
SELECT last_insert_rowid();

-- Balance of every account: initialBalance + inflows - outflows.
selectBalances:
SELECT
    a.id AS accountId,
    a.initialBalance + COALESCE(SUM(
        CASE
            WHEN t.type IN ('INCOME', 'TRANSFER_IN') THEN t.amount
            WHEN t.type IN ('EXPENSE', 'TRANSFER_OUT') THEN -t.amount
            ELSE 0
        END
    ), 0) AS balance
FROM Account a
LEFT JOIN TransactionEntity t ON t.accountId = a.id
GROUP BY a.id;
