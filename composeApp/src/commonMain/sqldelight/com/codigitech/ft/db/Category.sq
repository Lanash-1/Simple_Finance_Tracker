CREATE TABLE Category (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    icon TEXT NOT NULL,
    colorHex TEXT NOT NULL,
    type TEXT NOT NULL,
    isCustom INTEGER NOT NULL DEFAULT 0,
    isDefault INTEGER NOT NULL DEFAULT 0
);

selectAll:
SELECT * FROM Category ORDER BY isDefault ASC, isCustom ASC, name ASC;

selectByType:
SELECT * FROM Category WHERE type = ? ORDER BY isDefault ASC, isCustom ASC, name ASC;

selectById:
SELECT * FROM Category WHERE id = ?;

selectDefaultForType:
SELECT * FROM Category WHERE type = ? AND isDefault = 1 LIMIT 1;

insert:
INSERT INTO Category(name, icon, colorHex, type, isCustom, isDefault)
VALUES (?, ?, ?, ?, ?, ?);

update:
UPDATE Category SET name = ?, icon = ?, colorHex = ? WHERE id = ?;

deleteById:
DELETE FROM Category WHERE id = ? AND isDefault = 0;

countAll:
SELECT COUNT(*) FROM Category;

lastInsertRowId:
SELECT last_insert_rowid();
