# Copy to keystore.properties (git-ignored) and fill in for signed release builds.
# Generate the upload key once:
#   keytool -genkeypair -v -keystore pocketsum-upload.jks -alias pocketsum -keyalg RSA -keysize 2048 -validity 10000
storeFile=../pocketsum-upload.jks
storePassword=
keyAlias=pocketsum
keyPassword=
